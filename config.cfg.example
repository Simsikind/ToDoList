; Example configuration for ToDoList
; Copy to config.cfg and adjust values.
; NOTE: config.cfg is gitignored because it contains secrets.

[database]
host = localhost
port = 5432
dbname = todo_db
user = todo_user
password = ChangeME!
sslmode = prefer

[security]
; JWT signing secret (required). Use a long random string.
; Alternative: set environment variable TODO_JWT_SECRET
jwt_secret = ChangeME-Long-Random-Secret

[printer]
enable = true
prntname = Generic / Text Only

[app]
base_url = https://todo.example.org
; Optional: default timezone for new users
default_timezone = UTC
; The single account treated as Owner: can grant/revoke Admin status for
; other users via the /admin dashboard. Not manageable via the UI itself.
owner_email = owner@example.org
; Optional, comma-separated: one-time admin bootstrap. On each backend start,
; these accounts are granted is_admin=true if not already admin. Never
; revokes - once set, admin status is managed live via /admin by the owner.
admin_emails = owner@example.org
